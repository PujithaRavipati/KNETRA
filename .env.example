# Copy to .env.local (and add in Vercel > Settings > Environment Variables).
# The form ID is the last part of your Formspree endpoint: https://formspree.io/f/<this part>
NEXT_PUBLIC_FORMSPREE_ID=

# Your domain once bought, e.g. https://knetra.in (sitemap, canonical and share links use it)
NEXT_PUBLIC_SITE_URL=
